<?xml version="1.0" encoding="utf-8"?>
<!-- Конфигурация файлов для SignPath (вставляется в проект Kadro на SignPath как конфигурация по умолчанию).
     release.yml отправляет на подпись zip с одним файлом: сначала Kadro.exe, потом установщик Kadro-Setup-X.Y.Z.exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set product-name="Kadro">
      <include path="Kadro.exe" min-matches="0" />
      <include path="Kadro-Setup-*.exe" min-matches="0" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
