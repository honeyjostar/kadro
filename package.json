{
  "name": "kadro",
  "productName": "Kadro",
  "version": "0.4.1",
  "description": "Kadro — бесплатный видеоредактор с ИИ-функциями, работающими локально",
  "license": "GPL-3.0-or-later",
  "author": "yaposspall",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "e2e": "playwright test",
    "models": "esbuild scripts/fetch-models.ts --bundle --platform=node --format=esm --packages=external --outfile=build/fetch-models.mjs --log-level=warning && node build/fetch-models.mjs",
    "test:ci": "vitest run tests/unit tests/integration/export.test.ts tests/integration/anim.test.ts tests/integration/retime.test.ts"
  },
